{
  "name": "form-tail",
  "version": "0.3.0",
  "description": "Дописывает хвост значения в поле формы. Первая поставка — фамилия, имя и отчество.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moryarty45/form-tail.git"
  },
  "bugs": {
    "url": "https://github.com/Moryarty45/form-tail/issues"
  },
  "homepage": "https://github.com/Moryarty45/form-tail#readme",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./ru": {
      "import": {
        "types": "./dist/ru/index.d.ts",
        "default": "./dist/ru/index.js"
      },
      "require": {
        "types": "./dist/ru/index.d.cts",
        "default": "./dist/ru/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build:lexicon": "tsx scripts/build-lexicon.ts",
    "check:lexicon": "tsx scripts/check-lexicon.ts",
    "build": "tsup",
    "dev": "tsx scripts/dev.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.react.json && tsc --noEmit -p tsconfig.examples.json",
    "test:coverage": "vitest run --coverage",
    "pack:check": "tsx scripts/check-pack.ts",
    "ci": "npm run lint && npm run typecheck && npm run test:coverage && npm run check:lexicon && npm run build && npm run pack:check",
    "prepublishOnly": "npm run ci"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.8",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "0.28.2",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "publint": "^0.3.25",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
